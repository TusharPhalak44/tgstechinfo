# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tgstechinfo_cms
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Configuration (Required for email functionality)
EMAIL_USER=info@tgstechinfo.com
EMAIL_PASSWORD="your-password-here"
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_FROM=info@tgstechinfo.com
EMAIL_REPLY_TO=info@tgstechinfo.com
EMAIL_ORGANIZATION=TGS Tech Info

# Backup / High-Deliverability Providers:
# Option 1 - Brevo (Already configured in tgstechinfo.com DNS):
# BREVO_API_KEY=xkeysib-your_brevo_smtp_key_here
# BREVO_USER=info@tgstechinfo.com

# Option 2 - SendGrid:
# SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:5173

# API URL (optional, defaults to localhost)
API_URL=http://localhost:5000

# Server Configuration
PORT=5000
NODE_ENV=development
